<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 【2026-10-06 问题44】用户设的工作区在 /sdcard（如
         /sdcard/Download/claude-workspace），但 App 没这个权限 →
         `ls /sdcard/...` 报 Permission denied → Agent 只能退回
         files/workspace（应用私有）→ 表现为「Agent 的工作区和设置的不一样」。
         声明后需用户在系统设置里手动授权「所有文件访问」。 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- 语音输入（SpeechToText，系统识别服务） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 拍照（+ 菜单）需要临时共享输出文件给相机 App -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 悬浮窗（Clawd 吉祥物，2026-10-09）。Android 6+ 需用户在系统设置里
         手动授权（Settings.ACTION_MANAGE_OVERLAY_PERMISSION）。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- ══════════════════════════════════════════════════════════════
         应用列表权限（2026-10-06）—— 用户指出「你都没要获取应用列表权限」

         Android 11+ 默认过滤包可见性，PackageManager 看不到别的 App。
         下面 <queries> 只放开**显式声明**的几个包；要能查询/列举**任意**
         已装应用（比如「装了哪些浏览器」「按名字找应用」），必须声明
         QUERY_ALL_PACKAGES。

         Google Play 对此权限有审核限制（需核心功能依赖），但本项目自建
         分发、不依赖 Play，不受影响。tools:ignore 消 lint 提示。
         ══════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- ══════════════════════════════════════════════════════════════
         包可见性声明（2026-10-06）—— 缺了它「检测不到 Termux」

         Android 11+（API 30+）默认过滤包可见性：不声明 <queries> 时
         `packageManager.getPackageInfo("com.termux", 0)` 对**任何**
         第三方包都抛 NameNotFoundException —— 哪怕 Termux 就装在旁边。
         （实测：本机 pm list 能看到 com.termux，App 里却探测为未安装。）

         声明后 TermuxChannel.isAvailable() / 引导页检测才准。
         ══════════════════════════════════════════════════════════════ -->
    <!-- ══════════════════════════════════════════════════════════════
         Termux RUN_COMMAND 权限（2026-10-06 用户报错：Not allowed to
         start service Intent ... without permission
         com.termux.permission.RUN_COMMAND）

         Termux 的 RunCommandService 声明了
         android:permission="com.termux.permission.RUN_COMMAND" ——
         调用方必须在 manifest 里声明同名 uses-permission，**并且运行时请求**。

         ⚠️ 权限等级：**dangerous**（Termux 源码 manifest 里写的是
         android:protectionLevel="dangerous"，不是 signature）——
         所以弹系统框就能授予，**不需要与 Termux 同签名**。
         实测 `pm grant com.ccm.app com.termux.permission.RUN_COMMAND` 成功。

         授权入口：
         · 设置 → 环境 → 「外接 Termux」行的授权按钮
         · 或首次引导页选外接 Termux 时的提示按钮
         · 或系统设置 → 应用 → CCM → 权限 → 在 Termux 中运行命令
         ══════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <queries>
        <!-- 外接 Termux 通道（RUN_COMMAND Intent 发给它执行命令） -->
        <package android:name="com.termux" />
        <!-- Termux 的附加组件（:api 提供 termux-api 命令、:x11 起图形环境） -->
        <package android:name="com.termux.api" />
        <package android:name="com.termux.x11" />
        <!-- Shizuku（手机 Shell 通道探测，同理会受可见性影响） -->
        <package android:name="moe.shizuku.manager" />
        <!-- 系统浏览器（OpenUrl 用 ACTION_VIEW，部分设备需显式声明） -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:theme="@style/Theme.CCM"
        android:usesCleartextTraffic="true"
        android:largeHeap="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 前台服务：保活 + 桥接服务器 -->
        <service
            android:name=".service.CcmService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          Clawd 悬浮窗服务（2026-10-09）。

          【为什么 foregroundServiceType=specialUse】
          Android 14+（targetSdk 34+）要求所有前台服务声明类型。
          悬浮窗既不是 dataSync 也不是 mediaPlayback —— 它属于
          「其他用途」，官方归类是 specialUse（需在 manifest 里
          用 PROPERTY_SPECIAL_USE_FGS_SUBTYPE 说明理由，见下）。

          【为什么用前台服务而不是普通 Service】
          Android 8+ 后台服务限制：App 退到后台后普通 Service 几秒内
          就会被系统冻结。悬浮窗必须持续存活（用户可能切走十几分钟），
          所以必须走 startForeground + 常驻通知。
        -->
        <service
            android:name=".service.ClawdOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Desktop-pet style status overlay showing AI agent progress" />
        </service>

        <!-- Shizuku user service：在 shell uid 下操作虚拟副屏 -->
        <service
            android:name=".bridge.PhoneUseService"
            android:exported="false" />

        <!--
          Termux RUN_COMMAND 结果接收（2026-10-06 加）。

          官方 wiki 的声明是裸的 `<service android:name=".PluginResultsService" />`
          —— **不需要 exported="true"**：PendingIntent 投递走的是系统通道
          （PendingIntent 里封装了目标身份），不是普通 startService，
          外部应用无法直接调它。exported=true 反而多余且扩大攻击面。
        -->
        <service
            android:name=".tools.bash.TermuxResultService"
            android:exported="false" />

        <!--
          Shizuku 的 binder 接收点。

          【为什么必须声明】
          Shizuku 不是通过 bindService 把 binder 给应用的，而是**由 Shizuku 端主动推**：
          它按 uid 找到应用，调用应用自己声明的 ShizukuProvider，把 binder 塞进去，
          应用再存起来给 Shizuku.pingBinder() 用。

          没有这个 provider 的后果实测过：Shizuku.pingBinder() 恒为 false，
          界面上的授权按钮永远不出现（因为 available() 就是 false），
          而 logcat 里唯一的线索是
            ContentProviderHelper: No provider info for content provider com.ccm.app.shizuku
          —— 光看「Shizuku 在跑、CCM 也在授权列表里」会完全摸不着头脑。

          authority 必须是 <包名>.shizuku，这是 Shizuku 硬编码的前缀规则。
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.ccm.app.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false" />

        <!--
          FileProvider（2026-10-06 补）—— 「拍照」功能依赖它。

          【原来缺这个声明】ChatScreenConnected 的拍照走
          FileProvider.getUriForFile(ctx, "$packageName.fileprovider", file)，
          但 Manifest 里没有对应 provider → getUriForFile 抛
          IllegalArgumentException（"Couldn't find meta-data for provider
          with authority com.ccm.app.fileprovider"）→ 被外层 catch 静默
          吞掉 → 用户看到「点拍照没反应」。
          res/xml/file_paths.xml 早就写好了，只是没人引用。

          exported=false + grantUriPermissions=true：只把 URI 临时授权给
          相机 App（Intent 带 FLAG_GRANT_*），不暴露给其他应用。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 开机自启 -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
